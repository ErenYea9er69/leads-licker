# Copy to .env or export in your shell. Every value is optional. Nothing here is stored in the database.

# Language model for the pipeline (profiling, planning, qualifying, drafting).
# The MCP server does not need one: the host AI reasons.
# Set one key. LLM_PROVIDER chooses when several are set: anthropic, openai, gemini, groq, deepseek.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER=
# Pin a model only if you must. Leave empty to use the built-in list of current models with fallback.
LLM_MODEL=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_QUALIFY_MAX=80

# Search backends, tried in this order. Without keys the app uses Exa, then DuckDuckGo.
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Where the SQLite database lives. Default: ~/.agent-reach/discovery.db
AGENT_REACH_DISCOVERY_DB=
# Use another skills folder (for example your edited copy).
AGENT_REACH_SKILLS_DIR=

# Automatic posting. Off by default. Reddit gives API access by approval only (since Nov 2025).
# Posting needs mode=automatic AND this switch AND approved credentials below.
AGENT_REACH_ALLOW_AUTOPOST=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
GITHUB_TOKEN=
# Several accounts per platform: link each with an alias, then set variables named after it.
# Alias alt1 on Reddit reads REDDIT_ALT1_CLIENT_ID, REDDIT_ALT1_CLIENT_SECRET, REDDIT_ALT1_USERNAME, REDDIT_ALT1_PASSWORD.
# GitHub reads GITHUB_<ALIAS>_TOKEN. Ask the CEO "which tokens do I need" (reach_connections) for the live list.

# YouTube. The key enables search, comment counts and comments (Data API v3, 100 quota units per search).
# Transcripts need the extra: pip install "agent-reach[youtube]". The app never posts to YouTube.
YOUTUBE_API_KEY=
# Units the app may spend per day. Google grants 10000 by default.
YOUTUBE_DAILY_QUOTA=9000

# MCP surface. company (default): the host sees the CEO tools and the owner tools.
# full: every low level tool is visible too.
AGENT_REACH_MCP_MODE=

# Dashboard API (agent-reach dashboard). Required when the API is not reachable only from this machine.
AGENT_REACH_API_KEY=
ALLOWED_ORIGINS=

# Optional: audit with a different provider than the specialists use. Needs that provider's key.
# AGENT_REACH_AUDITOR_PROVIDER=openai
# AGENT_REACH_AUDITOR_MODEL=
